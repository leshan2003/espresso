# Local research records, original repositories, and private material.
/archive/
/private/
**/local/

# Default-deny the publication roots; only reviewed release folders are allowed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CITATION.cff
!/NOTICE.md
!/requirements.txt
!/CMakeLists.txt
!/Costmodel/
!/verilog/
!/fpga/
!/papers/
!/slides/
!/results/
!/input_example/
!/docs/
!/tools/
!/.github/
/papers/*
!/papers/README.md
/slides/*
!/slides/README.md
!/slides/espresso-overview.md
/results/*
!/results/README.md
!/results/resource/

# Tool output and machine-specific state.
**/.git/
.DS_Store
._*
Thumbs.db
desktop.ini
~$*
.env
.env.*
*.pem
*.key
.vscode/
.idea/
__pycache__/
*.py[cod]
.venv/
build/
build-*/
CMakeFiles/
CMakeCache.txt
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.zip
*.7z
*.rar
*.pth
*.pt
*.npy
*.npz

# Vivado output; only source RTL is released.
.Xil/
*.cache/
*.runs/
*.sim/
*.gen/
*.hw/
*.ip_user_files/
*.dcp
*.wdb
*.bit
*.jou
*.log

# LaTeX output; retain source bibliographies and figures locally.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.out
*.toc
